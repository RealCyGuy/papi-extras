  "name": "Text Placeholder API Extras",
  "description": "A few extra placeholders for Text Placeholder API such as advancement count and biome!",
  "authors": [
    "Cyrus Yip"
  ],
  "contact": {
    "homepage": "https://github.com/RealCyGuy/papi-extras",
    "sources": "https://github.com/RealCyGuy/papi-extras"
  },
  "license": "MIT",
  "icon": "assets/papi-extras/icon.png",
  "environment": "*",
  "entrypoints": {
